              "type": "integer",
              "required": true,
              "nullable": false
            }
          ]
        }
      }
    },
    {
      "kind": "transform",
      "slug": "compare-settlement",
      "transform": {
        "inputs": {
          "settlement": "normalize-settlement",
          "ledger": "read-ledger"
        },
        "sql": "SELECT s.evaluation_id AS evaluation_id, s.batch_id AS batch_id, s.line_id AS line_id, s.provider_event_id AS provider_event_id, s.event_type AS event_type, s.order_id AS order_id, s.currency AS currency, s.reported_gross AS reported_gross, s.reported_fee AS reported_fee, s.reported_net AS reported_net, l.order_id AS ledger_order_id, l.ledger_gross AS ledger_gross, s.reported_gross - l.ledger_gross AS difference, CASE WHEN l.ledger_gross IS NULL THEN 1 ELSE 0 END AS unmatched FROM settlement s LEFT JOIN ledger l ON s.provider_event_id = l.provider_event_id AND s.event_type = l.event_type AND s.currency = l.currency ORDER BY line_id",
        "output_kind": "rows",
        "output_contract": {
          "representation": "rows",
          "fields": [
            {
              "name": "evaluation_id",
              "type": "string",
              "required": true,
              "nullable": false
            },
            {
              "name": "batch_id",
              "type": "string",
              "required": true,
              "nullable": false
            },
            {
              "name": "line_id",
              "type": "string",
              "required": true,
              "nullable": false
            },
            {
              "name": "provider_event_id",
              "type": "string",
              "required": true,
              "nullable": false
            },
            {
              "name": "event_type",
              "type": "string",
              "required": true,
              "nullable": false
            },
            {
              "name": "order_id",
              "type": "string",
              "required": true,
              "nullable": false
            },
            {
              "name": "currency",
              "type": "string",
              "required": true,
              "nullable": false
            },
            {
              "name": "reported_gross",
              "type": "integer",
              "required": true,
              "nullable": false
            },
            {
              "name": "reported_fee",
              "type": "integer",
              "required": true,
              "nullable": false
            },
            {
              "name": "reported_net",
              "type": "integer",
              "required": true,
              "nullable": false
            },
            {
              "name": "ledger_order_id",
              "type": "string",
              "required": false,
              "nullable": true
            },
            {
              "name": "ledger_gross",
              "type": "integer",
              "required": false,
              "nullable": true
            },
            {
              "name": "difference",
              "type": "number",
              "required": false,
              "nullable": true
            },
            {
              "name": "unmatched",
              "type": "integer",
