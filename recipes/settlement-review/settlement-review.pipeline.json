    {
      "kind": "transform",
      "slug": "normalize-settlement",
      "transform": {
        "inputs": {
          "settlement": "read-settlement"
        },
        "sql": "SELECT evaluation_id, batch_id, line_id, provider_event_id, event_type, order_id, currency, CAST(reported_gross AS SIGNED) AS reported_gross, CAST(reported_fee AS SIGNED) AS reported_fee, CAST(reported_net AS SIGNED) AS reported_net FROM settlement",
        "output_kind": "rows",
        "output_contract": {
          "representation": "rows",
          "fields": [
            {
              "name": "evaluation_id",
              "type": "string",
              "required": true,
              "nullable": false
            },
            {
              "name": "batch_id",
              "type": "string",
              "required": true,
              "nullable": false
            },
            {
              "name": "line_id",
              "type": "string",
              "required": true,
              "nullable": false
            },
            {
              "name": "provider_event_id",
              "type": "string",
              "required": true,
              "nullable": false
            },
            {
              "name": "event_type",
              "type": "string",
              "required": true,
              "nullable": false
            },
            {
              "name": "order_id",
              "type": "string",
              "required": true,
              "nullable": false
            },
            {
              "name": "currency",
              "type": "string",
              "required": true,
              "nullable": false
            },
