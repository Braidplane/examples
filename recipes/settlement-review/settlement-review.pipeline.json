    {
      "kind": "transform",
      "slug": "batch-totals",
      "transform": {
        "inputs": {
          "comparison": "compare-settlement"
        },
        "sql": "SELECT evaluation_id, batch_id, currency, COUNT(*) AS line_count, COUNT(ledger_gross) AS matched_count, SUM(unmatched) AS unmatched_count, SUM(reported_gross) AS reported_gross, SUM(reported_fee) AS reported_fee, SUM(reported_net) AS reported_net, SUM(ledger_gross) AS matched_ledger_gross, SUM(difference) AS matched_difference FROM comparison GROUP BY evaluation_id, batch_id, currency",
